{
  "manifest_version": 3,
  "name": "buu",
  "version": "0.1.0",
  "description": "Lets local agents drive this browser through the buu native host.",
  "minimum_chrome_version": "125",
  "key": "",
  "background": { "service_worker": "background.js" },
  "permissions": ["debugger", "tabs", "tabGroups", "nativeMessaging", "alarms", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_title": "buu" }
}
